# ── Python ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg

# ── Virtual envs ─────────────────────────────────────────
env/
venv/
.venv/
ENV/
.conda/

# ── Jupyter ───────────────────────────────────────────────
.ipynb_checkpoints/
# Clear outputs before committing notebooks
# notebooks/*.ipynb  ← do NOT ignore — commit empty-output notebooks

# ── Data — DVC only, never git ────────────────────────────
data/raw/
data/processed/
*.csv
*.parquet
*.json.gz

# ── Models — DVC only, never git ─────────────────────────
models/population/
models/individual/
models/virtual/
*.pkl
*.pt
*.onnx
*.h5
*.pb
# Keep registry.json (small, human-readable — always commit)
!models/registry.json

# ── MLflow ────────────────────────────────────────────────
# mlflow/ is the bind-mount dir for the Docker MLflow server.
# Keep the dir itself (via mlflow/.gitkeep) but ignore all runtime content.
mlflow/mlflow.db
mlflow/artifacts/
mlruns/
mlflow.db
mlartifacts/

# ── PyTorch Lightning (NeuralProphet training logs) ───────
lightning_logs/

# ── Secrets / keys — NEVER in git ─────────────────────────
# Env files (keep ONLY the .env.example template)
.env
.env.*
!.env.example
secrets/
# Crypto material & API keys
*.pem
*.key
*.p12
*.pfx
# Cloud / OAuth credential files
firebase*.json
service_account*.json
client_secret*.json
*credentials*.json
gcp-*.json
*-key.json
.secrets.toml

# ── Reports / figures — safe to commit (small PNGs) ──────
# reports/figures/ intentionally NOT ignored

# ── Node / Frontend ──────────────────────────────────────
node_modules/

# ── OS ────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini

# ── IDEs ─────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ── Testing ───────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/

# ── DVC ───────────────────────────────────────────────────
# DVC pointer files (.dvc) are committed — do NOT ignore them
/tmp/
.claude/
