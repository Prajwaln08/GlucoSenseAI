# ── Python ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg

# ── Virtual envs ─────────────────────────────────────────
env/
venv/
.venv/
ENV/
.conda/

# ── Jupyter ───────────────────────────────────────────────
.ipynb_checkpoints/
# Clear outputs before committing notebooks
# notebooks/*.ipynb  ← do NOT ignore — commit empty-output notebooks

# ── Data — DVC only, never git ────────────────────────────
data/raw/
data/processed/
*.csv
*.parquet
*.json.gz
*.md
# Markdown policy: keep ONLY the root README on GitHub; internal docs stay local-only.
!/README.md
!/docs/validation.md

# ── Models — NOTHING under models/ is committed (code only) ──────────────
# All model artifacts AND the registry are generated locally and stay local
# (regenerated by training); only the .gitkeep placeholder keeps the dir in git.
models/*
!models/.gitkeep
*.pkl
*.pt
*.onnx
*.h5
*.pb

# ── MLflow ────────────────────────────────────────────────
# mlflow/ is the bind-mount dir for the Docker MLflow server.
# Keep the dir itself (via mlflow/.gitkeep) but ignore all runtime content.
mlflow/mlflow.db
mlflow/artifacts/
mlruns/
mlflow.db
mlartifacts/

# ── PyTorch Lightning (NeuralProphet training logs) ───────
lightning_logs/

# ── Secrets / keys — NEVER in git ─────────────────────────
# Env files (keep ONLY the .env.example template)
.env
.env.*
!.env.example
secrets/
# Crypto material & API keys
*.pem
*.key
*.p12
*.pfx
# Cloud / OAuth credential files
firebase*.json
service_account*.json
client_secret*.json
*credentials*.json
gcp-*.json
*-key.json
.secrets.toml

# ── Reports — generated comparison output / leaderboards ──
# Keep only the dir placeholders; ignore all generated content.
reports/comparison/
reports/figures/*
!reports/figures/.gitkeep

# ── Plots / graphs / figures — generated, never git ──────
*.png
*.jpg
*.jpeg
*.svg

# App bundled assets (icons/splash) ARE shipped — they're referenced by
# mobile/app.json and required by EAS prebuild. The image rules above target
# generated ML plots/figures, not the app's own assets.
!mobile/assets/**

# ── Node / Frontend ──────────────────────────────────────
node_modules/

# ── OS ────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini

# ── IDEs ─────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ── Testing ───────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/

# ── DVC ───────────────────────────────────────────────────
# DVC pointer files (.dvc) are committed — do NOT ignore them
/tmp/
.claude/

# Local dev SQLite databases
*.db
local_dev.db

# Private career/working docs — never publish
docs/GAP_ANALYSIS.md
docs/EVAL_ROADMAP.md
