# ──────────────────────────────────────────────────────────────────────────────
# GlucoSense AI — Serving Image (Phase 2)
#
# Lighter than the training image — no torch, neuralprophet, or optuna.
# Runs the FastAPI prediction endpoint on port 8000.
#
# Build:
#   docker build -f docker/Dockerfile.serve -t glucosense-api:latest .
# ──────────────────────────────────────────────────────────────────────────────

FROM python:3.10-slim

# libgomp1 — required by LightGBM / XGBoost OpenMP threading
# curl     — healthcheck probe
RUN apt-get update && apt-get install -y --no-install-recommends \
        libgomp1 \
        curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Deps layer — rebuilds only when requirements.txt changes
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip \
 && pip install --no-cache-dir -r requirements.txt

# Source code only — models/data are bind-mounted at runtime (local dev)
COPY src/ src/

# Demo models for the deployed (Render) app: a small bundle (demo personal model +
# lightgbm base) extracted into /app/models so the demo accounts render forecasts in
# the cloud, where the full 62 GB model tree is absent. Additive — warm_cache logs
# harmless warnings for any model not in this bundle. Local dev bind-mounts over it.
COPY deploy/demo_models.tar.gz /tmp/demo_models.tar.gz
RUN mkdir -p /app/models && tar xzf /tmp/demo_models.tar.gz -C /app && rm /tmp/demo_models.tar.gz

ENV PYTHONPATH=/app \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    KMP_DUPLICATE_LIB_OK=TRUE

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
    CMD curl -sf http://localhost:8000/health || exit 1

CMD ["uvicorn", "src.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
